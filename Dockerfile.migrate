# One-off image: applies Prisma migrations and seeds frameworks into Railway Postgres.
FROM oven/bun:1.4.4

WORKDIR /app
COPY . .

RUN PRISMA_SKIP_POSTINSTALL_GENERATE=true bun install --ignore-scripts

WORKDIR /app/packages/db
RUN node scripts/combine-schemas.js && node scripts/generate-prisma-client-js.js

CMD ["sh", "-c", "bunx prisma migrate deploy && bun run db:seed && echo DB_SETUP_DONE && sleep infinity"]
